APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe Checkout (card payments). Dummy mode simulates the card flow
# locally; set STRIPE_DUMMY=false and paste real test/live keys to go live.
STRIPE_KEY=pk_test_dummy_not_a_real_key
STRIPE_SECRET=sk_test_dummy_not_a_real_key
STRIPE_WEBHOOK_SECRET=whsec_dummy_not_a_real_secret
STRIPE_DUMMY=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Business Assistant — OpenAI / OpenRouter / any OpenAI-compatible endpoint
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT=30

# Optional provider overrides (handled in AI settings UI)
# ai_provider = openai | openrouter | anthropic | google | ollama
# ai_api_key = [stored secret]
# ai_model = (if different from default)
# ai_base_url = (if different, e.g. https://openrouter.ai/api/v1)
# ai_temperature = (if different)
# ai_max_tokens = (if different)
# ai_timeout = (seconds)

# AI analysis defaults (tuned in Admin → AI Settings)
AI_DEFAULT_ANALYSIS_PERIOD=30
AI_RECOMMENDATIONS_GENERATE_FREQUENCY=24
AI_MIN_PRODUCT_SALES_THRESHOLD=100
AI_LOW_STOCK_THRESHOLD=5
AI_PROFIT_MARGIN_WARNING_THRESHOLD=15
AI_SALES_DECLINE_WARNING_THRESHOLD=-20
AI_FORECASTING_PERIOD=30
AI_RESPONSE_LANGUAGE=en
